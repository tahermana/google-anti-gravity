# Public Supabase values only.
# Safe to ship in Flutter when Row-Level Security is enabled and tested.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key

# Never put these in Flutter, mobile, web, or desktop client builds:
# SUPABASE_SERVICE_ROLE_KEY
# DATABASE_PASSWORD
# DIRECT_DATABASE_URL
# JWT_SECRET